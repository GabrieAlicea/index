# Supabase (required — the app will not build/run meaningfully without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only inside Route Handlers /
# Server Actions that need to bypass RLS (webhooks, admin jobs).
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email) — required for booking confirmation / mechanic decision
# emails to actually send. Get a free key at resend.com.
RESEND_API_KEY=

# Stripe Connect — publishable key alone is enough for client-side Elements
# prep; the actual charge/payout flow needs STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET too (see docs/REVVY_PRD.md §17 roadmap — not built
# yet). Use test-mode keys (pk_test_/sk_test_) during development.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps: no key needed. Geocoding runs through OpenStreetMap's free Nominatim
# API and the map UI renders free OSM tiles via Leaflet — see
# lib/maps/geocode.ts and components/maps/. Swap to Google Maps or a paid
# OSM provider (Geoapify, MapTiler) if you outgrow Nominatim's ~1req/s
# unauthenticated rate limit.

# Twilio (SMS) — not yet wired up
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
